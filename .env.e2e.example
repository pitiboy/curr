# Copy to .env.e2e locally (never commit). Used by @full-stack Playwright specs.
E2E_STRAPI_URL=http://127.0.0.1:1337
# Default: the Vite preview Playwright starts (:4173). Against `npm run dev:f` instead:
# E2E_BACKOFFICE_URL=http://127.0.0.1:5173/backoffice
# Emails, not usernames: the login input is type="email".
E2E_DATAENTRY_EMAIL=dataentry@example.com
E2E_DATAENTRY_PASSWORD=replace-me
E2E_EDITOR_EMAIL=editor@example.com
E2E_EDITOR_PASSWORD=replace-me
