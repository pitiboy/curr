{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "[ ! -f \"$HOME/.cursor/skills/impeccable/scripts/impeccable\" ] || \"$HOME/.cursor/skills/impeccable/scripts/impeccable\" hook",
        "matcher": "^Write$",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/prep-generated-before-git.sh",
        "matcher": "git\\s+(checkout|switch|merge|pull|rebase)\\b",
        "timeout": 30
      }
    ]
  }
}
