NODE_ENV=development
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
# Comma-separated extra origins for production CORS (e.g. Appsmith)
# CORS_ORIGINS=https://your-appsmith.example.com

# Secrets — generate with: node scripts/generate-secrets.js
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — sqlite locally, or Postgres via URL / discrete vars
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
# Render: set DATABASE_URL (Internal) and omit the discrete vars
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Cloudinary
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret
# Create presets in Cloudinary Dashboard > Settings > Upload
CLOUDINARY_UPLOAD_PRESET=your_upload_preset_name
CLOUDINARY_FOLDER=strapi-uploads

# Transaction and receipt writes. Omitted values are the defaults.
# CONTENT_DEFAULT_STATUS=draft
#   draft: create/update cannot publish. published: an editor may save as published.
# CONTENT_PUBLISHER_MUST_DIFFER=true
#   true: the user in entered_by cannot publish that document.

# Google OAuth for Content API / backoffice login (Users & Permissions grant)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SPA URL after OAuth (trailing slash). Local dev default: http://localhost:5173/backoffice/
# BACKOFFICE_OAUTH_CALLBACK=http://localhost:5173/backoffice/

# Backoffice workflow form ids, comma-separated. Empty or omitted: no extra forms.
# A browser can override this list for itself. Other users keep this value.
# BACKOFFICE_WORKFLOWS=member-fee,egg-daily-entry

# Content-backoffice: egg distribution sale currency (default HUF)
# VITE_EGG_SALE_CURRENCY=HUF

# Site root redirect. Unset locally: Strapi / -> /admin. Set on cPanel only, not shared .env.
# PUBLIC_HOME_REDIRECT=/backoffice/
# PUBLIC_HOME_REDIRECT=/static/about
