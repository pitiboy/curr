# --- Strapi (teljes fa: dist, public, package.json) ---
# Másold .env.deploy:kor.fejlesztesek.hu néven, és töltsd ki az FTP_PASS értékét.
FTP_HOST=kor.fejlesztesek.hu
FTP_USER=node@fejlesztesek.hu
FTP_REMOTE_DIR=kor-szupatak
FTP_PASS=
# FTP_PORT=21
# only-newer vagy transfer-all
FTP_OVERRIDE_POLICY=transfer-all

# --- Content backoffice SPA (apps/content-backoffice/dist → public/backoffice) ---
# Másold .env.deploy:backoffice:kor.fejlesztesek.hu néven. Az FTP_* mezők ugyanazok lehetnek.
# VITE_STRAPI_URL=https://kor.fejlesztesek.hu
# BACKOFFICE_REMOTE_SUBPATH=public/backoffice