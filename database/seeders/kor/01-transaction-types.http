# Tranzakciótípusok
# A database/seeders JS seederek httpYac változata (seed:full + initial-data).
#
#   httpyac send database/seeders/kor/0*.http --env kor --all
#
# Környezet: local | kor | edizone a http-client.env.json-ban.
# Token: http-client.private.env.json, példányonként Full access API token.
# Ha a természetes kulcs már létezik, a POST nem fut le.

###
# @name lookup-tx_elrendelt
{{
  exports.failed_tx_elrendelt = false;
  exports.encoded = encodeURIComponent("Elrendelt");
}}
GET {{baseUrl}}/api/transaction-types?filters[name][$eq]={{encoded}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    exports.failed_tx_elrendelt = true;
    console.error("lookup failed: Elrendelt", response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      exports.tx_elrendelt = found;
    }
  }
}}

###
# @name create-tx_elrendelt
{{
  const exists = typeof tx_elrendelt !== "undefined" && tx_elrendelt;
  const failed = typeof failed_tx_elrendelt !== "undefined" && failed_tx_elrendelt;
  if (exists || failed) {
    exports.$cancel = true;
  } else {

  }
}}
POST {{baseUrl}}/api/transaction-types
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
  "data": {
    "name": "Elrendelt",
    "category": "future",
    "description": "Tervezett/elrendelt kiadás"
  }
}

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200 && response.statusCode !== 201) {
    console.error("create failed: Elrendelt", response.statusCode, response.body);
  } else {
    const created = parsed && parsed.data && parsed.data.documentId;
    if (created) {
      exports.tx_elrendelt = created;
    }
  }
}}

