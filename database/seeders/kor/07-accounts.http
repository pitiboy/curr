###
# @name create-acct_keszpenz
{{
  const exists = typeof acct_keszpenz !== "undefined" && acct_keszpenz;
  const failed = typeof failed_acct_keszpenz !== "undefined" && failed_acct_keszpenz;
  const categoryId = typeof cat_asset !== "undefined" && cat_asset;
  const mappedOrg = typeof org_i_3_penzugyi_igazgatosag !== "undefined" && org_i_3_penzugyi_igazgatosag;
  const mainOrg = typeof org_main !== "undefined" && org_main;
  const organizationId = mappedOrg || mainOrg;
  if (exists || failed) {
    exports.$cancel = true;
  } else if (!categoryId || !organizationId) {
    console.error("missing relation for Készpénz");
    exports.$cancel = true;
  } else {
    if (!mappedOrg) {
      console.error("organization not found, using main: I/3. Pénzügyi Igazgatóság");
    }
    exports.categoryId = categoryId;
    exports.organizationId = organizationId;
  }
}}
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
  "data": {
    "name": "Készpénz",
    "code": "1000",
    "description": "Készpénz számla",
    "category": "{{categoryId}}",
    "organization": "{{organizationId}}"
  }
}

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200 && response.statusCode !== 201) {
    console.error("create failed: Készpénz", response.statusCode, response.body);
  } else {
    const created = parsed && parsed.data && parsed.data.documentId;
    if (created) {
      exports.acct_keszpenz = created;
    }
  }
}}

