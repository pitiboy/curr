# Számlakategóriák
# A database/seeders JS seederek httpYac változata (seed:full + initial-data).
#
#   httpyac send database/seeders/kor/0*.http --env kor --all
#
# Környezet: local | kor | edizone a http-client.env.json-ban.
# Token: http-client.private.env.json, példányonként Full access API token.
# Ha a természetes kulcs már létezik, a POST nem fut le.

###
# @name lookup-cat_revenue
{{
  exports.failed_cat_revenue = false;
  exports.encoded = encodeURIComponent("revenue");
}}
GET {{baseUrl}}/api/account-categories?filters[type][$eq]={{encoded}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    exports.failed_cat_revenue = true;
    console.error("lookup failed: Bevétel", response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      exports.cat_revenue = found;
    }
  }
}}

###
# @name create-cat_revenue
{{
  const exists = typeof cat_revenue !== "undefined" && cat_revenue;
  const failed = typeof failed_cat_revenue !== "undefined" && failed_cat_revenue;
  if (exists || failed) {
    exports.$cancel = true;
  } else {

  }
}}
POST {{baseUrl}}/api/account-categories
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
  "data": {
    "name": "Bevétel",
    "type": "revenue",
    "description": "Bevételi és jövedelmi számlák",
    "color": "#10B981"
  }
}

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200 && response.statusCode !== 201) {
    console.error("create failed: Bevétel", response.statusCode, response.body);
  } else {
    const created = parsed && parsed.data && parsed.data.documentId;
    if (created) {
      exports.cat_revenue = created;
    }
  }
}}

