###
# @name lookup-ccy_huf
{{
  exports.failed_ccy_huf = false;
  exports.encoded = encodeURIComponent("HUF");
}}
GET {{baseUrl}}/api/currency-types?filters[code][$eq]={{encoded}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    exports.failed_ccy_huf = true;
    console.error("lookup failed: Magyar Forint", response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      exports.ccy_huf = found;
    }
  }
}}

###
# @name create-ccy_huf
{{
  const exists = typeof ccy_huf !== "undefined" && ccy_huf;
  const failed = typeof failed_ccy_huf !== "undefined" && failed_ccy_huf;
  if (exists || failed) {
    exports.$cancel = true;
  } else {
  const categoryId = typeof ccy_cat_cash !== "undefined" && ccy_cat_cash;
  if (!categoryId) {
    console.error("missing category for Magyar Forint");
    exports.$cancel = true;
  } else {
    exports.categoryId = categoryId;
  }
  }
}}
POST {{baseUrl}}/api/currency-types
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
  "data": {
    "code": "HUF",
    "name": "Magyar Forint",
    "unit": "HUF",
    "category": "{{categoryId}}"
  }
}

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200 && response.statusCode !== 201) {
    console.error("create failed: Magyar Forint", response.statusCode, response.body);
  } else {
    const created = parsed && parsed.data && parsed.data.documentId;
    if (created) {
      exports.ccy_huf = created;
    }
  }
}}

