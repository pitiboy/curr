# Számlakategóriák
# A rekordok a data/account-categories.json fájlban vannak.
#
#   httpyac send database/seeders/http/kor/0*.http --all --env kor
#
# Környezet: local | kor | edizone a http-client.env.json-ban.
# Token: http-client.private.env.json, példányonként Full access API token.
# Ha a természetes kulcs már létezik, a POST nem fut le.

{{
  if (typeof catItems === "undefined") {
    const fs = require("fs");
    const path = require("path");
    exports.catItems = JSON.parse(
      fs.readFileSync(path.join(__dirname, "data/account-categories.json"), "utf8")
    );
    exports.catIds = {};
    exports.catFailed = {};
  }
}}

###
# @name lookup-account-category
# @loop for item of catItems
{{
  exports.encoded = encodeURIComponent(item.type);
}}
GET {{baseUrl}}/api/account-categories?filters[type][$eq]={{encoded}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    catFailed[item.type] = true;
    exports.catFailed = catFailed;
    console.error("lookup failed: " + item.name, response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      catIds[item.type] = found;
      exports.catIds = catIds;
    }
  }
}}

###
# @name create-account-category
# @loop for item of catItems
{{
  if (catIds[item.type] || catFailed[item.type]) {
    exports.$cancel = true;
  } else {
    exports.catPayload = JSON.stringify({ data: item });
  }
}}
POST {{baseUrl}}/api/account-categories
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{{catPayload}}

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200 && response.statusCode !== 201) {
    console.error("create failed: " + item.name, response.statusCode, response.body);
  } else {
    const created = parsed && parsed.data && parsed.data.documentId;
    if (created) {
      catIds[item.type] = created;
      exports.catIds = catIds;
    }
  }
}}
