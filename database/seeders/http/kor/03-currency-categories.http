# Pénznem-kategóriák
# A database/seeders JS seederek httpYac változata (seed:full + initial-data).
#
#   httpyac send database/seeders/kor/0*.http --env kor --all
#
# Környezet: local | kor | edizone a http-client.env.json-ban.
# Token: http-client.private.env.json, példányonként Full access API token.
# Ha a természetes kulcs már létezik, a POST nem fut le.

###
# @name lookup-ccy_cat_cash
{{
  exports.failed_ccy_cat_cash = false;
  exports.encoded = encodeURIComponent("CASH");
}}
GET {{baseUrl}}/api/currency-categories?filters[code][$eq]={{encoded}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    exports.failed_ccy_cat_cash = true;
    console.error("lookup failed: Pénz", response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      exports.ccy_cat_cash = found;
    }
  }
}}

###
# @name create-ccy_cat_cash
{{
  const exists = typeof ccy_cat_cash !== "undefined" && ccy_cat_cash;
  const failed = typeof failed_ccy_cat_cash !== "undefined" && failed_ccy_cat_cash;
  if (exists || failed) {
    exports.$cancel = true;
  } else {

  }
}}
POST {{baseUrl}}/api/currency-categories
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
  "data": {
    "code": "CASH",
    "name": "Pénz",
    "description": "Hagyományos pénzügyi eszközök",
    "icon": "💰",
    "color": "#10B981"
  }
}

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200 && response.statusCode !== 201) {
    console.error("create failed: Pénz", response.statusCode, response.body);
  } else {
    const created = parsed && parsed.data && parsed.data.documentId;
    if (created) {
      exports.ccy_cat_cash = created;
    }
  }
}}

