# Tagságtípusok
# A database/seeders JS seederek httpYac változata (seed:full + initial-data).
#
#   httpyac send database/seeders/kor/0*.http --env kor --all
#
# Környezet: local | kor | edizone a http-client.env.json-ban.
# Token: http-client.private.env.json, példányonként Full access API token.
# Ha a természetes kulcs már létezik, a POST nem fut le.

###
# @name lookup-mem_bentlako_tag
{{
  exports.failed_mem_bentlako_tag = false;
  exports.encoded = encodeURIComponent("Bentlakó tag");
}}
GET {{baseUrl}}/api/membership-types?filters[name][$eq]={{encoded}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    exports.failed_mem_bentlako_tag = true;
    console.error("lookup failed: Bentlakó tag", response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      exports.mem_bentlako_tag = found;
    }
  }
}}

