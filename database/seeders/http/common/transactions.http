###
# @name lookup-transaction
# @loop for item of trxRows
# Matches by import_key. A row imported before import_key existed is found by
# its legacy entered_by marker (no import_key yet) and gets backfilled below.
{{
  exports.encodedKey = encodeURIComponent(item.key);
  exports.encodedLegacy = encodeURIComponent(item.legacyKey);
}}
GET {{baseUrl}}/api/transactions?status=draft&filters[$or][0][import_key][$eq]={{encodedKey}}&filters[$or][1][entered_by][$eq]={{encodedLegacy}}&fields[0]=import_key&fields[1]=entered_by&pagination[pageSize]=10
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    trxFailed[item.key] = true;
    exports.trxFailed = trxFailed;
    console.error("lookup failed: " + item.key, response.statusCode, response.body);
  } else {
    const found = (parsed && parsed.data) || [];
    const same = found.find((entry) => entry.import_key === item.key);
    const legacy = found.filter((entry) => !entry.import_key && entry.entered_by === item.legacyKey);
    if (same) {
      trxIds[item.key] = same.documentId;
      exports.trxIds = trxIds;
    } else if (legacy.length === 1) {
      trxBackfill[item.key] = legacy[0].documentId;
      exports.trxBackfill = trxBackfill;
    } else if (legacy.length > 1) {
      trxFailed[item.key] = true;
      exports.trxFailed = trxFailed;
      console.error("several legacy rows for " + item.legacyKey + ", fix by hand: " +
        legacy.map((entry) => entry.documentId).join(", "));
    }
  }
}}

###
# @name backfill-import-key
# @loop for item of trxRows
# Sets import_key on rows the previous seeder created. status=draft keeps the
# draft validation (incomplete relations are allowed, nothing is published).
{{
  if (!trxBackfill[item.key] || trxIds[item.key] || trxFailed[item.key]) {
    exports.$cancel = true;
  } else {
    exports.backfillId = trxBackfill[item.key];
    exports.trxPayload = JSON.stringify({ data: { import_key: item.key } });
  }
}}
PUT {{baseUrl}}/api/transactions/{{backfillId}}?status=draft
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{{trxPayload}}

{{
  if (response.statusCode !== 200 && response.statusCode !== 201) {
    trxFailed[item.key] = true;
    exports.trxFailed = trxFailed;
    console.error("backfill failed: " + item.legacyKey + " -> " + item.key, response.statusCode, response.body);
  } else {
    trxIds[item.key] = trxBackfill[item.key];
    exports.trxIds = trxIds;
    console.info("backfilled import_key: " + item.legacyKey + " -> " + item.key);
  }
}}

###
# @name create-transaction
# @loop for item of trxRows
{{
  const currencyId = trxCurrencyIds[trxCurrencyCode];
  if (trxIds[item.key] || trxFailed[item.key]) {
    exports.$cancel = true;
  } else if (!currencyId) {
    console.error("missing currency for " + item.key);
    exports.$cancel = true;
  } else {
    const data = {
      date: item.date,
      amount: item.amount,
      description: item.description,
      currency_type: currencyId,
      entered_by: item.legacyKey,
      import_key: item.key,
    };
    const relations = {
      credit_account: item.creditAccount && trxAccountIds[item.creditAccount],
      debit_account: item.debitAccount && trxAccountIds[item.debitAccount],
      transaction_type: item.transactionType && trxTypeIds[item.transactionType],
      organization: item.organization && trxOrganizationIds[item.organization],
    };
    Object.keys(relations).forEach((field) => {
      if (relations[field]) data[field] = relations[field];
    });
    exports.trxPayload = JSON.stringify({ data });
  }
}}
POST {{baseUrl}}/api/transactions?status=draft
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{{trxPayload}}

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200 && response.statusCode !== 201) {
    // Possibly the unique index: another run created it meanwhile. Checked below.
    trxRecheck[item.key] = true;
    exports.trxRecheck = trxRecheck;
    trxCreateErrors[item.key] = response.statusCode + " " + response.body;
    exports.trxCreateErrors = trxCreateErrors;
  } else {
    const created = parsed && parsed.data && parsed.data.documentId;
    if (created) {
      trxIds[item.key] = created;
      exports.trxIds = trxIds;
    }
  }
}}

###
# @name recheck-transaction
# @loop for item of trxRows
# A failed create counts as imported when the key exists by now (concurrent run).
{{
  if (!trxRecheck[item.key]) {
    exports.$cancel = true;
  } else {
    exports.encodedKey = encodeURIComponent(item.key);
  }
}}
GET {{baseUrl}}/api/transactions?status=draft&filters[import_key][$eq]={{encodedKey}}&fields[0]=import_key&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  const found = response.statusCode === 200 && parsed && parsed.data && parsed.data[0];
  if (found) {
    trxIds[item.key] = found.documentId;
    exports.trxIds = trxIds;
    console.info("already imported (concurrent run): " + item.key);
  } else {
    console.error("create failed: " + item.key, trxCreateErrors[item.key]);
  }
}}
