# Tranzakciók az Excel pénzmozgás-táblából (Pénzmozgások munkalap)
# A rekordok a dataDir/transactions.json fájlban vannak, soronként az Excel oszlopaival:
#   row = Excel sorszám, date = Dátum, payer = Forrás (fizet), payee = Kinek fizettük,
#   ledger = Cél hely, project = Organization/Projekt, purpose = Rendeltetés,
#   operation = Művelet, amount = Összeg (Excelben előjelesen; importnál |amount|,
#   a követel/tartozik címkék változatlanok),
#   place = Hely, description = Leírás,
#   credit_label / debit_label = a tábla credit_Account / Debit_account cellája.
# Az Év és Hó oszlop a dátumból jön, ezért nincs külön mezője.
#
# A tartozik és a követel a tábla saját oszlopa. A transaction-import-keys.mjs
# feloldja őket a számlatükörre, és a sor credit_account / debit_account /
# organization / transaction_type mezőjébe írja. Ezek az irányadók.
# Ha a soron nincs credit_account vagy debit_account, a JSON tetején lévő
# táblák maradnak a tartalék (régi sorokhoz):
#   credit_account  = operationCreditAccounts[operation] vagy partyAccounts[payer]
#   debit_account   = expenseDebitAccounts[purpose], ha operation = Költség,
#                     különben partyAccounts[payee]
#                     Ha a két oldal ugyanaz a számla, a debit üres marad.
#   Számla helyett tagi számla is megadható: tag:<azonosító> = a tag 1101-es
#   tagi számlája, saját:<azonosító> = a tag 1001-es saját (homály) számlája,
#   pl. tag:pál. A tagot az azonosítója alapján keresi meg; ha nincs ilyen
#   tag vagy számlája, a mező üres marad, és a futás kiírja, hány sort érint.
#   transaction_type = a sor transaction_type mezője, különben
#                      operationTransactionTypes[operation], különben
#                      placeTransactionTypes[place]
#   organization    = a sor organization mezője, különben
#                     projectOrganizations[project], ha nincs: mainOrganization
#   currency_type   = currencyCode
#   description     = Leírás, alatta az eredeti oszlopok markdown HTML-kommentben.
#                     Minden ilyen sor önálló komment, ezért a markdown
#                     megjelenítés nem írja ki. A backoffice listája és a
#                     readonly megtekintés is eldobja a teljes komment-sorokat;
#                     a véglegesítő űrlap leírásmezője a nyers szöveget mutatja.
#                     Üres leírásnál csak a kommentblokk kerül be.
#                       <!-- excel -->
#                       <!-- Excel: #<sorszám> -->
#                       <!-- Forrás: … -->
#                       <!-- Kinek: … -->
#                       <!-- Követel: … -->
#                       <!-- Tartozik: … -->
#                       <!-- Cél hely: … -->
#                       <!-- Projekt: … -->
#                       <!-- Rendeltetés: … -->
#                       <!-- Művelet: … -->
#                       <!-- Hely: … -->
#                       <!-- /excel -->
#   import_key      = a sor import_key mezője, ez a természetes kulcs (egyedi)
#   entered_by      = keyPrefix + row, csak olvasható jelölés
#
# import_key: excel:<sha256 20 hex> a JSON import_key_fields listájában lévő
# mezőkből (most: pénznem, dátum, összeg, forrás, jogosult, projekt), azonos
# kulcsnál #2, #3. A sorszám nincs benne, így az Excel sorrendje szabadon
# változhat; ha a hat mező valamelyike változik, új kulcsot kap, és új
# tranzakcióként jön be. Újragenerálás: npm run seed:kor:transactions:keys
# Ami nem képezhető le, üres marad. A tranzakció piszkozatként jön létre
# (status=draft), a hiányzó számlát vagy szervezetet a backoffice-ban kell
# kitölteni publikálás előtt.
#
#   npm run seed:http:kor:transactions -- local
#   npm run seed:http:kor:transactions -- prod
#   npm run seed:http:kor:transactions:reset:local
#
# Nincs a 0*.http körben, külön kell futtatni.
# Előfeltétel: a 01-08 seederek már lefutottak (számlák, típusok, szervezetek, HUF).
# Ha a dataDir-ben nincs transactions.json, nem csinál semmit.
# Környezet: local | prod a http-client.env.json-ban.
# Token: http-client.private.env.json, példányonként Full access API token.
# Ha az import_key már létezik, a POST nem fut le. Az import_key előtti
# futásból maradt sorokat (entered_by = keyPrefix + row, import_key üres)
# a seeder megtalálja, és PUT-tal beírja a kulcsukat, nem duplikál.
# Az adatbázisban részleges unique index véd (src/transaction-import-key.ts),
# így párhuzamos futásnál a második POST elbukik, és ezt a seeder
# "already imported" esetként kezeli.

{{
  if (typeof trxRows === "undefined") {
    const fs = require("fs");
    const path = require("path");
    if (typeof dataDir === "undefined" || !dataDir) {
      throw new Error("dataDir is missing");
    }
    const file = path.resolve(process.cwd(), dataDir, "transactions.json");
    const source = fs.existsSync(file)
      ? JSON.parse(fs.readFileSync(file, "utf8"))
      : { transactions: [] };
    if (!fs.existsSync(file)) {
      console.info("no transactions.json in " + dataDir + ", skipping");
    }

    const pick = (table, key) =>
      (table && key != null && Object.prototype.hasOwnProperty.call(table, key) && table[key]) || null;

    const commentValue = (value) => {
      if (value == null) return "-";
      const text = String(value).replace(/-->/g, "-- >").replace(/\s+/g, " ").trim();
      return text || "-";
    };
    const commentLine = (text) => "<!-- " + text + " -->";
    const excelBlock = (item) =>
      [
        "excel",
        "Excel: #" + item.row,
        "Forrás: " + commentValue(item.payer),
        "Kinek: " + commentValue(item.payee),
        "Követel: " + commentValue(item.credit_label || item.credit_account),
        "Tartozik: " + commentValue(item.debit_label || item.debit_account),
        "Cél hely: " + commentValue(item.ledger),
        "Projekt: " + commentValue(item.project),
        "Rendeltetés: " + commentValue(item.purpose),
        "Művelet: " + commentValue(item.operation),
        "Hely: " + commentValue(item.place),
        "/excel",
      ].map(commentLine).join("\n");

    const items = source.transactions || [];
    const seenKeys = new Set();
    items.forEach((item) => {
      if (!item.import_key) {
        throw new Error("row " + item.row + " has no import_key, run: npm run seed:kor:transactions:keys");
      }
      if (seenKeys.has(item.import_key)) {
        throw new Error("duplicate import_key " + item.import_key + " (row " + item.row + ")");
      }
      seenKeys.add(item.import_key);
    });

    // tag:<identifier> -> member.account (1101), saját:<identifier> -> member.private_account (1001)
    const memberRef = (value) => {
      if (typeof value !== "string") return null;
      const match = /^(tag|saját):\s*(.+)$/.exec(value.normalize("NFC").trim());
      if (!match) return null;
      return {
        ref: match[1] + ":" + match[2].trim(),
        field: match[1] === "tag" ? "account" : "private_account",
        identifier: match[2].trim(),
      };
    };
    const accountRef = (value) => {
      if (typeof value !== "string" || !value.trim()) return null;
      const member = memberRef(value);
      return member ? member.ref : value.normalize("NFC").trim();
    };

    const rows = items.map((item) => {
      const credit = accountRef(
        item.credit_account ||
        pick(source.operationCreditAccounts, item.operation) ||
        pick(source.partyAccounts, item.payer));
      let debit = accountRef(
        item.debit_account ||
        (item.operation === "Költség" && pick(source.expenseDebitAccounts, item.purpose)) ||
        pick(source.partyAccounts, item.payee));
      if (debit && debit === credit) debit = null;
      return {
        key: item.import_key,
        legacyKey: source.keyPrefix + item.row,
        date: item.date,
        amount: item.amount,
        description: [item.description, excelBlock(item)].filter(Boolean).join("\n\n"),
        creditAccount: credit,
        debitAccount: debit,
        transactionType:
          item.transaction_type ||
          pick(source.operationTransactionTypes, item.operation) ||
          pick(source.placeTransactionTypes, item.place),
        organization:
          item.organization ||
          pick(source.projectOrganizations, item.project) ||
          source.mainOrganization ||
          null,
      };
    });

    const unique = (values) => [...new Set(values.filter(Boolean))];
    exports.trxRows = rows;
    exports.trxCurrencyCodes = rows.length && source.currencyCode ? [source.currencyCode] : [];
    exports.trxCurrencyCode = source.currencyCode;
    const accountRefs = rows.flatMap((row) => [row.creditAccount, row.debitAccount]).filter(Boolean);
    const refRows = {};
    accountRefs.forEach((ref) => { refRows[ref] = (refRows[ref] || 0) + 1; });
    exports.trxRefRows = refRows;
    exports.trxAccountNames = unique(accountRefs.filter((ref) => !memberRef(ref)));
    exports.trxMemberIdentifiers = unique(accountRefs.map((ref) => memberRef(ref)).filter(Boolean).map((m) => m.identifier));
    exports.trxTypeNames = unique(rows.map((row) => row.transactionType));
    exports.trxOrganizationNames = unique(rows.map((row) => row.organization));
    exports.trxCurrencyIds = {};
    exports.trxAccountIds = {};
    exports.trxTypeIds = {};
    exports.trxOrganizationIds = {};
    exports.trxIds = {};
    exports.trxFailed = {};
    exports.trxBackfill = {};
    exports.trxRecheck = {};
    exports.trxCreateErrors = {};
  }
}}

###
# @name require-currency-type
# @loop for code of trxCurrencyCodes
{{
  exports.encoded = encodeURIComponent(code);
}}
GET {{baseUrl}}/api/currency-types?filters[code][$eq]={{encoded}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    console.error("lookup failed: " + code, response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      trxCurrencyIds[code] = found;
      exports.trxCurrencyIds = trxCurrencyIds;
    } else {
      console.error("not found: " + code);
    }
  }
}}

###
# @name require-account
# @loop for accountName of trxAccountNames
{{
  exports.encoded = encodeURIComponent(accountName);
}}
GET {{baseUrl}}/api/accounts?filters[name][$eq]={{encoded}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    console.error("lookup failed: " + accountName, response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      trxAccountIds[accountName] = found;
      exports.trxAccountIds = trxAccountIds;
    } else {
      console.error("account not found: " + accountName + " (" + (trxRefRows[accountName] || 0) + " row refs, left empty)");
    }
  }
}}

###
# @name require-member-account
# @loop for memberIdentifier of trxMemberIdentifiers
{{
  exports.encoded = encodeURIComponent(memberIdentifier);
}}
GET {{baseUrl}}/api/members?filters[identifier][$eq]={{encoded}}&fields[0]=identifier&populate[account][fields][0]=name&populate[private_account][fields][0]=name&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  const refs = { account: "tag:" + memberIdentifier, private_account: "saját:" + memberIdentifier };
  const used = Object.keys(refs).filter((field) => trxRefRows[refs[field]]);
  if (response.statusCode !== 200) {
    console.error("member lookup failed: " + memberIdentifier, response.statusCode, response.body);
  } else {
    const member = parsed && parsed.data && parsed.data[0];
    used.forEach((field) => {
      const account = member && member[field];
      if (account && account.documentId) {
        trxAccountIds[refs[field]] = account.documentId;
        exports.trxAccountIds = trxAccountIds;
      } else {
        console.error((member ? "member has no " + field + ": " : "member not found: ") +
          refs[field] + " (" + trxRefRows[refs[field]] + " row refs, left empty)");
      }
    });
  }
}}

