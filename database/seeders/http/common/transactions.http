###
# @name lookup-transaction
# @loop for item of trxRows
{{
  exports.encoded = encodeURIComponent(item.key);
}}
GET {{baseUrl}}/api/transactions?status=draft&filters[entered_by][$eq]={{encoded}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    trxFailed[item.key] = true;
    exports.trxFailed = trxFailed;
    console.error("lookup failed: " + item.key, response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      trxIds[item.key] = found;
      exports.trxIds = trxIds;
    }
  }
}}

###
# @name create-transaction
# @loop for item of trxRows
{{
  const currencyId = trxCurrencyIds[trxCurrencyCode];
  if (trxIds[item.key] || trxFailed[item.key]) {
    exports.$cancel = true;
  } else if (!currencyId) {
    console.error("missing currency for " + item.key);
    exports.$cancel = true;
  } else {
    const data = {
      date: item.date,
      amount: item.amount,
      description: item.description,
      currency_type: currencyId,
      entered_by: item.key,
    };
    const relations = {
      credit_account: item.creditAccount && trxAccountIds[item.creditAccount],
      debit_account: item.debitAccount && trxAccountIds[item.debitAccount],
      transaction_type: item.transactionType && trxTypeIds[item.transactionType],
      organization: item.organization && trxOrganizationIds[item.organization],
    };
    Object.keys(relations).forEach((field) => {
      if (relations[field]) data[field] = relations[field];
    });
    exports.trxPayload = JSON.stringify({ data });
  }
}}
POST {{baseUrl}}/api/transactions?status=draft
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{{trxPayload}}

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200 && response.statusCode !== 201) {
    console.error("create failed: " + item.key, response.statusCode, response.body);
  } else {
    const created = parsed && parsed.data && parsed.data.documentId;
    if (created) {
      trxIds[item.key] = created;
      exports.trxIds = trxIds;
    }
  }
}}
