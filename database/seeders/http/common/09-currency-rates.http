# Árfolyamok (közös — npm run seed:http:kor|edizone)
# Org-specifikus fájl: ../kor/09-currency-rates.http, ../edizone/09-currency-rates.http
# A rekordok a dataDir/currency-rates.json fájlban vannak.
# rate: hány egység cél pénznem = 1 egység forrás pénznem (schema).
#
#   npm run seed:http:kor -- local
#   npm run seed:http:edizone -- prod
#
# A dataDir a kor/data vagy az edizone/data mappa.
# Környezet: local | prod a http-client.env.json-ban.
# Token: http-client.private.env.json, példányonként Full access API token.
# Ha ugyanaz a pénznempár és valid_from már létezik, a POST nem fut le.
#
# httpyac @loop csak egy request-blokkra érvényes (###-ig), ezért a from/to
# lookup külön loop a kódokra, majd a rate existence/create a rateItems-re.

{{
  if (typeof rateItems === "undefined") {
    const fs = require("fs");
    const path = require("path");
    if (typeof dataDir === "undefined" || !dataDir) {
      throw new Error("dataDir is missing");
    }
    const loaded = JSON.parse(
      fs.readFileSync(path.resolve(process.cwd(), dataDir, "currency-rates.json"), "utf8")
    );
    exports.rateItems = loaded;
    exports.rateCurrencyCodes = [
      ...new Set(
        loaded.flatMap((item) => [item.fromCurrencyCode, item.toCurrencyCode])
      ),
    ];
    exports.rateCurrencyIds = {};
    exports.rateFailed = {};
    exports.rateExists = {};
  }
}}

###
# @name require-rate-currency
# @loop for code of rateCurrencyCodes
{{
  exports.encoded = encodeURIComponent(code);
}}
GET {{baseUrl}}/api/currency-types?filters[code][$eq]={{encoded}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (e) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    console.error("currency type lookup failed: " + code, response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      rateCurrencyIds[code] = found;
      exports.rateCurrencyIds = rateCurrencyIds;
    } else {
      console.error("currency type not found: " + code);
    }
  }
}}

###
# @name lookup-currency-rate
# @loop for item of rateItems
{{
  const fromId = rateCurrencyIds[item.fromCurrencyCode];
  const toId = rateCurrencyIds[item.toCurrencyCode];
  const rateKey = item.fromCurrencyCode + "|" + item.toCurrencyCode + "|" + item.validFrom;
  exports.rateKey = rateKey;
  if (!fromId || !toId) {
    rateFailed[rateKey] = true;
    exports.rateFailed = rateFailed;
    exports.$cancel = true;
    console.error(
      "currency rate skipped: missing currency type",
      item.fromCurrencyCode,
      item.toCurrencyCode
    );
  } else {
    exports.$cancel = false;
    exports.fromId = fromId;
    exports.toId = toId;
    exports.encodedValidFrom = encodeURIComponent(item.validFrom);
  }
}}
GET {{baseUrl}}/api/currency-rates?filters[from_currency_type][documentId][$eq]={{fromId}}&filters[to_currency_type][documentId][$eq]={{toId}}&filters[valid_from][$eq]={{encodedValidFrom}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  if (!rateFailed[rateKey]) {
    let parsed = response.parsedBody;
    if (!parsed && response.body) {
      try { parsed = JSON.parse(response.body); } catch (e) { parsed = null; }
    }
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      rateExists[rateKey] = true;
      exports.rateExists = rateExists;
    }
  }
}}

###
# @name create-currency-rate
# @loop for item of rateItems
{{
  const rateKey = item.fromCurrencyCode + "|" + item.toCurrencyCode + "|" + item.validFrom;
  const fromDocId = rateCurrencyIds[item.fromCurrencyCode];
  const toDocId = rateCurrencyIds[item.toCurrencyCode];
  exports.ratePayload = null;
  exports.$cancel = false;
  if (rateFailed[rateKey] || rateExists[rateKey] || !fromDocId || !toDocId) {
    if (rateExists[rateKey]) {
      console.error(
        "create skipped (exists): " + item.fromCurrencyCode + " → " + item.toCurrencyCode
      );
    }
    exports.$cancel = true;
  } else {
    exports.ratePayload = JSON.stringify({
      data: {
        rate: item.rate,
        valid_from: item.validFrom,
        from_currency_type: fromDocId,
        to_currency_type: toDocId,
      },
    });
  }
}}
POST {{baseUrl}}/api/currency-rates
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{{ratePayload}}

{{
  if (ratePayload) {
    let parsed = response.parsedBody;
    if (!parsed && response.body) {
      try { parsed = JSON.parse(response.body); } catch (e) { parsed = null; }
    }
    if (response.statusCode !== 200 && response.statusCode !== 201) {
      console.error(
        "create failed: " + item.fromCurrencyCode + " → " + item.toCurrencyCode,
        response.statusCode,
        response.body
      );
    }
  }
}}
