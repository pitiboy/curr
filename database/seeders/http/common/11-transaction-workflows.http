###
# @name lookup-workflow
# @loop for item of wfItems
{{
  // Kulcs mindig az item-ből (ne exports.wfKey — a loop válaszban elcsúszhat).
  exports.encodedName = encodeURIComponent(item.name);
  exports.debitCode = encodeURIComponent(String(item.debit_account_code));
  exports.creditCode = encodeURIComponent(String(item.credit_account_code));
}}
GET {{baseUrl}}/api/transaction-workflows?filters[name][$eq]={{encodedName}}&filters[debit_account_code][$eq]={{debitCode}}&filters[credit_account_code][$eq]={{creditCode}}&status=published&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  const key = item.name + "|" + item.debit_account_code + "|" + item.credit_account_code;
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    wfFailed[key] = true;
    exports.wfFailed = wfFailed;
    console.error("lookup failed: " + key, response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      wfExists[key] = found;
      exports.wfExists = wfExists;
    }
  }
}}

###
# @name create-workflow
# @loop for item of wfItems
{{
  const key = item.name + "|" + item.debit_account_code + "|" + item.credit_account_code;
  exports.wfPayload = null;
  exports.$cancel = false;
  if (wfExists[key] || wfFailed[key]) {
    console.error("create skipped (exists): " + item.name);
    exports.$cancel = true;
  } else {
    const steps = [];
    let skipReason = null;
    for (const step of item.steps || []) {
      const debitCode = String(step.debit_code);
      const creditCode = String(step.credit_code);
      const debitOrigSide = wfOriginalAccountSide(debitCode);
      const creditOrigSide = wfOriginalAccountSide(creditCode);
      const debitFromOriginal = debitOrigSide != null;
      const creditFromOriginal = creditOrigSide != null;
      const currencyFromOriginal = wfIsOriginalCurrencyTemplate(step.currency);
      const debitIsMember =
        !debitFromOriginal && wfMemberCodes.includes(debitCode);
      const creditIsMember =
        !creditFromOriginal && wfMemberCodes.includes(creditCode);
      const debitId =
        debitIsMember || debitFromOriginal ? null : wfAccountIds[debitCode];
      const creditId =
        creditIsMember || creditFromOriginal
          ? null
          : wfAccountIds[creditCode];
      const orgFromOriginal = wfIsOriginalOrgTemplate(step.organization);
      const orgEmpty =
        step.organization == null ||
        step.organization === "" ||
        orgFromOriginal;
      const orgId = orgEmpty
        ? null
        : wfOrganizationIds[step.organization];
      const currencyId = currencyFromOriginal
        ? null
        : wfCurrencyIds[String(step.currency)];
      const typeId = step.transaction_type
        ? wfTypeIds[step.transaction_type]
        : undefined;
      // Name only what is missing; the description is just the step label.
      const missing = [];
      if (!debitIsMember && !debitFromOriginal && !debitId) {
        missing.push("debit account " + debitCode);
      }
      if (!creditIsMember && !creditFromOriginal && !creditId) {
        missing.push("credit account " + creditCode);
      }
      if (!orgEmpty && !orgId) missing.push("organization \"" + step.organization + "\"");
      if (!currencyFromOriginal && !currencyId) {
        missing.push("currency \"" + step.currency + "\"");
      }
      if (missing.length) {
        skipReason =
          "not found: " +
          missing.join(", ") +
          " (step \"" +
          step.description +
          "\")";
        break;
      }
      if (step.transaction_type && !typeId) {
        skipReason =
          "missing transaction_type \"" +
          step.transaction_type +
          "\" for step \"" +
          step.description +
          "\"";
        break;
      }
      if (debitIsMember && creditIsMember) {
        skipReason =
          "both sides are member codes on step \"" +
          step.description +
          "\" (unsupported)";
        break;
      }
      if (
        (debitIsMember && debitFromOriginal) ||
        (creditIsMember && creditFromOriginal)
      ) {
        skipReason =
          "member code cannot also be from_original on step \"" +
          step.description +
          "\"";
        break;
      }
      // __component must be the first JSON key — Strapi 5 Content API
      // rejects "Invalid key __component at step" otherwise.
      // Member + from_original on the other side stays a member component.
      const row = debitIsMember
        ? {
            __component: "workflow.step-member-debit",
            description: step.description,
            percent: step.percent,
            member_account_code: debitCode,
          }
        : creditIsMember
          ? {
              __component: "workflow.step-member-credit",
              description: step.description,
              percent: step.percent,
              member_account_code: creditCode,
            }
          : {
              __component: "workflow.step",
              description: step.description,
              percent: step.percent,
            };
      if (row.__component === "workflow.step-member-debit") {
        if (creditOrigSide) row.credit_account_from_original = creditOrigSide;
        else row.credit_account = creditId;
      } else if (row.__component === "workflow.step-member-credit") {
        if (debitOrigSide) row.debit_account_from_original = debitOrigSide;
        else row.debit_account = debitId;
      } else {
        if (debitOrigSide) row.debit_account_from_original = debitOrigSide;
        else row.debit_account = debitId;
        if (creditOrigSide) row.credit_account_from_original = creditOrigSide;
        else row.credit_account = creditId;
      }
      if (currencyFromOriginal) row.currency_from_original = true;
      else row.currency_type = currencyId;
      if (orgFromOriginal) row.organization_from_original = true;
      else if (orgId) row.organization = orgId;
      if (typeId) row.transaction_type = typeId;
      // Opt-in currency-rate conversion (0002 plan §5.1); omitted = false.
      if (step.apply_currency_rate === true) row.apply_currency_rate = true;
      if (step.copy_receipt) row.copy_receipt = true;
      steps.push(row);
    }
    const headerCurrencyId = item.currency
      ? wfCurrencyIds[String(item.currency)]
      : undefined;
    const headerTypeId = item.transaction_type
      ? wfTypeIds[item.transaction_type]
      : undefined;
    if (!skipReason && !steps.length) {
      skipReason = "no steps";
    } else if (!skipReason && item.currency && !headerCurrencyId) {
      skipReason = "missing currency " + item.currency;
    } else if (!skipReason && item.transaction_type && !headerTypeId) {
      skipReason = "missing transaction_type " + item.transaction_type;
    }
    if (skipReason) {
      console.error("create skipped: " + item.name + " → " + skipReason);
      wfFailed[key] = true;
      exports.wfFailed = wfFailed;
      exports.$cancel = true;
    } else {
      const data = {
        name: item.name,
        // Schema is string (glob/regex patterns); coerce JSON numbers from seeds.
        debit_account_code: String(item.debit_account_code),
        credit_account_code: String(item.credit_account_code),
        keep_original: item.keep_original !== false,
        steps_published: item.steps_published !== false,
        configuration: null,
        step: steps,
      };
      if (headerCurrencyId) data.currency_type = headerCurrencyId;
      if (headerTypeId) data.transaction_type = headerTypeId;
      exports.wfPayload = JSON.stringify({ data });
    }
  }
}}
POST {{baseUrl}}/api/transaction-workflows?status=published
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{{wfPayload}}

{{
  const key = item.name + "|" + item.debit_account_code + "|" + item.credit_account_code;
  if (wfPayload) {
    let parsed = response.parsedBody;
    if (!parsed && response.body) {
      try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
    }
    if (response.statusCode !== 200 && response.statusCode !== 201) {
      console.error("create failed: " + item.name, response.statusCode, response.body);
    } else {
      const created = parsed && parsed.data && parsed.data.documentId;
      if (created) {
        wfExists[key] = created;
        exports.wfExists = wfExists;
      }
    }
  }
}}
