# Transaction-workflow sablonok (Ügylet 1–9)
# A rekordok a dataDir/transaction-workflows/*.json fájlokból jönnek.
#
#   npm run seed:http:kor -- local
#   npm run seed:http:kor:transaction-workflows:local
#
# A dataDir a kor/data (vagy más instance) mappa.
# Környezet: local | prod a http-client.env.json-ban.
# Token: http-client.private.env.json, példányonként Full access API token.
# Előfeltétel: 01–07 seed (számlák, szervezetek, pénznemek, tranzakciótípusok),
# köztük 1900, 4500, EGG, FRUIT és a Tojóól szervezet a kor/data fájlokban.
# Tagi 1101/1001 → workflow.step-member-debit / step-member-credit (member_account_code).
# Fix T/K → workflow.step (mindkét account reláció). Convert a forrás trx-ből oldja a tagit.
# Ha a name + fejléc kód páros már létezik, a POST nem fut le.

{{
  if (typeof wfItems === "undefined") {
    const fs = require("fs");
    const path = require("path");
    if (typeof dataDir === "undefined" || !dataDir) {
      throw new Error("dataDir is missing");
    }
    const dir = path.resolve(process.cwd(), dataDir, "transaction-workflows");
    const files =
      fs.existsSync(dir)
        ? fs
            .readdirSync(dir)
            .filter((name) => name.endsWith(".json"))
            .sort()
        : [];
    exports.wfItems = files.map((name) =>
      JSON.parse(fs.readFileSync(path.join(dir, name), "utf8"))
    );
    // Tömb, ne Set — az exports blokkok között a Set nem marad meg megbízhatóan.
    exports.wfMemberCodes = ["1101", "1001"];
    const accountCodes = new Set();
    const organizationNames = new Set();
    const currencyCodes = new Set();
    const typeNames = new Set();
    for (const item of exports.wfItems) {
      if (item.currency) currencyCodes.add(String(item.currency));
      if (item.transaction_type) typeNames.add(item.transaction_type);
      for (const step of item.steps || []) {
        const debit = String(step.debit_code);
        const credit = String(step.credit_code);
        if (!exports.wfMemberCodes.includes(debit)) accountCodes.add(debit);
        if (!exports.wfMemberCodes.includes(credit)) accountCodes.add(credit);
        organizationNames.add(step.organization);
        currencyCodes.add(String(step.currency));
        if (step.transaction_type) typeNames.add(step.transaction_type);
      }
    }
    exports.wfAccountCodes = [...accountCodes].sort();
    exports.wfOrganizationNames = [...organizationNames].sort();
    exports.wfCurrencyCodes = [...currencyCodes].sort();
    exports.wfTypeNames = [...typeNames].sort();
    exports.wfAccountIds = {};
    exports.wfOrganizationIds = {};
    exports.wfCurrencyIds = {};
    exports.wfTypeIds = {};
    exports.wfExists = {};
    exports.wfFailed = {};
  }
}}

###
# @name require-account
# @loop for code of wfAccountCodes
{{
  exports.encoded = encodeURIComponent(code);
}}
GET {{baseUrl}}/api/accounts?filters[code][$eq]={{encoded}}&pagination[pageSize]=1
Authorization: Bearer {{token}}
Accept: application/json

{{
  let parsed = response.parsedBody;
  if (!parsed && response.body) {
    try { parsed = JSON.parse(response.body); } catch (error) { parsed = null; }
  }
  if (response.statusCode !== 200) {
    console.error("account lookup failed: " + code, response.statusCode, response.body);
  } else {
    const found = parsed && parsed.data && parsed.data[0] && parsed.data[0].documentId;
    if (found) {
      wfAccountIds[code] = found;
      exports.wfAccountIds = wfAccountIds;
    } else {
      console.error("account not found: " + code);
    }
  }
}}

