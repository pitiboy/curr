{
  "kind": "collectionType",
  "collectionName": "members",
  "info": {
    "singularName": "member",
    "pluralName": "members",
    "displayName": "Member",
    "description": "A community participant (individual)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "account": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::account.account",
      "configurable": false,
      "metadatas": {
        "label": "Számla",
        "description": "A taghoz tartozó számla (automatikusan létrejön)"
      }
    },
    "identifier": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "regex": "[a-z0-9\\-\\.]+",
      "metadatas": {
        "label": "Azonosító",
        "description": "A tag egyedi azonosítója"
      }
    },
    "name": {
      "type": "string",
      "maxLength": 255,
      "required": true,
      "metadatas": {
        "label": "Név",
        "description": "A tag neve"
      }
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true,
      "metadatas": {
        "label": "E-mail",
        "description": "A tag e-mail címe"
      }
    },
    "memberships": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::membership.membership",
      "mappedBy": "member",
      "metadatas": {
        "label": "Tagságok",
        "description": "A tag tagságai különböző szervezetekben"
      }
    }
  }
}
