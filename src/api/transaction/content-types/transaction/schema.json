{
  "kind": "collectionType",
  "collectionName": "transactions",
  "info": {
    "singularName": "transaction",
    "pluralName": "transactions",
    "displayName": "Transaction",
    "description": "Double-entry bookkeeping record with debit and credit entries"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "date": {
      "type": "date",
      "required": true
    },
    "amount": {
      "type": "decimal",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "debit_account": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::account.account",
      "metadatas": {
        "label": "Költség számlaszám",
        "description": "mire ment a pénz (anyag, bér, a megvett dolog)"
      },
      "inversedBy": "debit_transactions"
    },
    "credit_account": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::account.account",
      "metadatas": {
        "label": "Kifizető számlaszám",
        "description": "Honnan fizetted ki (pl készpénz vagy bank)"
      },
      "inversedBy": "credit_transactions"
    },
    "transaction_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::transaction-type.transaction-type",
      "metadatas": {
        "label": "Tranzakció típus",
        "description": "A tranzakció kategóriája"
      },
      "inversedBy": "transactions"
    },
    "currency_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::currency-type.currency-type",
      "metadatas": {
        "label": "Pénznem típus",
        "description": "A tranzakció pénzneme vagy erőforrás típusa"
      },
      "inversedBy": "transactions"
    },
    "related_transaction": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::transaction.transaction",
      "metadatas": {
        "label": "Kapcsolódó tranzakció",
        "description": "Egy másik tranzakció, amelyhez ez kapcsolódik"
      },
      "inversedBy": "related_transactions"
    },
    "related_transactions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::transaction.transaction",
      "metadatas": {
        "label": "Kapcsolódó tranzakciók",
        "description": "Az ehhez a tranzakcióhoz kapcsolódó tranzakciók"
      },
      "mappedBy": "related_transaction"
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::organization.organization",
      "metadatas": {
        "label": "Szervezet",
        "description": "A szervezeti fa azon csomópontja, amelyre a költség tartozik (a projekt)"
      },
      "inversedBy": "transactions"
    },
    "receipt": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::receipt.receipt",
      "metadatas": {
        "label": "Nyugta",
        "description": "A tranzakcióhoz tartozó nyugta"
      },
      "inversedBy": "transactions"
    }
  }
}
