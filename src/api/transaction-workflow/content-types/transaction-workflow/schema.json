{
  "kind": "collectionType",
  "collectionName": "transaction_workflows",
  "info": {
    "singularName": "transaction-workflow",
    "pluralName": "transaction-workflows",
    "displayName": "Transaction-workflow"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "credit_account_code": {
      "type": "string",
      "required": true,
      "regex": "^[0-9*?\\[\\]()|\\\\.^${}-]+$"
    },
    "debit_account_code": {
      "type": "string",
      "required": true,
      "regex": "^[0-9*?\\[\\]()|\\\\.^${}-]+$"
    },
    "transaction_type": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::transaction-type.transaction-type"
    },
    "currency_type": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::currency-type.currency-type"
    },
    "keep_original": {
      "type": "boolean",
      "required": false,
      "default": true
    },
    "steps_published": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "configuration": {
      "type": "json"
    },
    "step": {
      "type": "dynamiczone",
      "components": [
        "workflow.step",
        "workflow.step-member-debit",
        "workflow.step-member-credit"
      ],
      "required": true,
      "min": 1
    }
  }
}
