{
  "kind": "collectionType",
  "collectionName": "static_pages",
  "info": {
    "singularName": "static-page",
    "pluralName": "static-pages",
    "displayName": "Static Page",
    "description": "Public static pages (privacy policy, terms of service, about). Rendered without login at /static/{slug}?locale={hu|en}."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "maxLength": 255,
      "metadatas": {
        "label": "Cím",
        "description": "Az oldal címe (pl. Adatkezelési tájékoztató)"
      }
    },
    "slug": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "metadatas": {
        "label": "URL azonosító",
        "description": "A nyilvános cím vége: /static/{slug} (pl. privacy-policy, terms-of-service, about). Minden nyelven ugyanaz."
      },
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "body": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "metadatas": {
        "label": "Tartalom",
        "description": "Markdown (Strapi rich text). A címet ne ismételd # fejlécként, ## fejlécekkel kezdd."
      }
    },
    "footer_order": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "default": 0,
      "metadatas": {
        "label": "Sorrend",
        "description": "Sorrend a /static listában (kisebb előbb)"
      }
    }
  }
}
