{
  "kind": "collectionType",
  "collectionName": "memberships",
  "info": {
    "singularName": "membership",
    "pluralName": "memberships",
    "displayName": "Membership",
    "description": "Tagság: szervezet + tagságtípus + egy vagy több tag közös szabályokkal"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "maxLength": 255,
      "required": true,
      "metadatas": {
        "label": "Név",
        "description": "A tagság megjelenő neve (pl. csoportnév); relációkban ez látszik a documentId helyett"
      }
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::organization.organization",
      "inversedBy": "memberships",
      "metadatas": {
        "label": "Szervezet",
        "description": "A tagsághoz tartozó szervezet"
      }
    },
    "members": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::member.member",
      "inversedBy": "memberships",
      "metadatas": {
        "label": "Tagok",
        "description": "A tagsághoz tartozó tagok (egy rekordhoz több is választható)"
      }
    },
    "membership_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::membership-type.membership-type",
      "inversedBy": "memberships",
      "required": true,
      "metadatas": {
        "label": "Tagság típus",
        "description": "A tagság típusa (pl. tag, bentlakó tag, szimpatizáns)"
      }
    },
    "valid_from": {
      "type": "datetime",
      "required": true,
      "metadatas": {
        "label": "Érvényesség kezdete",
        "description": "A tagság érvényességének kezdő dátuma"
      }
    },
    "valid_to": {
      "type": "datetime",
      "metadatas": {
        "label": "Érvényesség vége",
        "description": "A tagság érvényesség vége (opcionális)"
      }
    },
    "rules": {
      "type": "json",
      "metadatas": {
        "label": "Szabályok",
        "description": "Opcionális tagságspecifikus szabályok (pl. tojás továbbosztás); hiányzó mezőnél a tagságtípus szabályai érvényesek"
      }
    }
  }
}
