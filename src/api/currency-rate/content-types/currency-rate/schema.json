{
  "kind": "collectionType",
  "collectionName": "currency_rates",
  "info": {
    "singularName": "currency-rate",
    "pluralName": "currency-rates",
    "displayName": "Currency Rate",
    "description": "Defines conversion rates between currency types over time"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "rate": {
      "type": "decimal",
      "required": true,
      "precision": 10,
      "scale": 6,
      "metadatas": {
        "label": "Árfolyam",
        "description": "Az árfolyam értéke (hány egység cél pénznem = 1 egység forrás pénznem)"
      }
    },
    "valid_from": {
      "type": "datetime",
      "required": true,
      "metadatas": {
        "label": "Érvényesség kezdete",
        "description": "Az árfolyam érvényességének kezdő dátuma"
      }
    },
    "valid_to": {
      "type": "datetime",
      "metadatas": {
        "label": "Érvényesség vége",
        "description": "Az árfolyam érvényességének vége (opcionális)"
      }
    },
    "from_currency_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::currency-type.currency-type",
      "inversedBy": "exchange_rates_from",
      "metadatas": {
        "label": "Forrás pénznem",
        "description": "Az árfolyam forrás pénzneme"
      }
    },
    "to_currency_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::currency-type.currency-type",
      "inversedBy": "exchange_rates_to",
      "metadatas": {
        "label": "Cél pénznem",
        "description": "Az árfolyam cél pénzneme"
      }
    }
  }
}
