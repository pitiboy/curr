{
  "collectionName": "components_workflow_step_member_credits",
  "info": {
    "displayName": "Step with Member as Credit",
    "icon": "user"
  },
  "options": {},
  "attributes": {
    "description": {
      "type": "string",
      "default": "{1}",
      "required": true
    },
    "percent": {
      "type": "decimal",
      "required": true,
      "default": 100,
      "min": 0,
      "max": 100
    },
    "member_account_code": {
      "type": "string",
      "required": true,
      "maxLength": 10
    },
    "debit_account": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::account.account",
      "required": false
    },
    "debit_account_from_original": {
      "type": "enumeration",
      "enum": ["debit", "credit"],
      "required": false
    },
    "transaction_type": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::transaction-type.transaction-type"
    },
    "currency_type": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::currency-type.currency-type",
      "required": false
    },
    "currency_from_original": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "organization": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::organization.organization",
      "required": false
    },
    "organization_from_original": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "copy_receipt": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "apply_currency_rate": {
      "type": "boolean",
      "required": false,
      "default": false
    }
  },
  "config": {}
}
