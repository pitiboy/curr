# Strapi origin without path (local dev: port 1337).
# Production build (`vite build` / `npm run build:f`) reads `.env.production`.
VITE_STRAPI_URL=http://localhost:1337

# Prefix of the app bar title: `VITE_APP_TITLE » app.title`. Leave empty to show only the translated app title.
VITE_APP_TITLE=KÖR

# Account-code filters on the create form. JavaScript regex.
# When unset, debit is /^5/ and credit is /^(1|3)/.
# VITE_DEBIT_CODES=/^5/
# VITE_CREDIT_CODES=/^(1|3)/
