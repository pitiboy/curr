# Strapi origin without path (local dev: port 1337)
VITE_STRAPI_URL=http://localhost:1337

# Prefix of the app bar title: `VITE_APP_TITLE » app.title`. Leave empty to show only the translated app title.
VITE_APP_TITLE=KÖR

# Account-code filters, workflow toggles, and publish policy come from Strapi
# (Backoffice feature collection + GET /api/backoffice/config). Seed per instance:
#   npm run seed:backoffice-features:kor
