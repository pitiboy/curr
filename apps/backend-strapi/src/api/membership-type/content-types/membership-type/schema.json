{
  "kind": "collectionType",
  "collectionName": "membership_types",
  "info": {
    "singularName": "membership-type",
    "pluralName": "membership-types",
    "displayName": "Membership Type",
    "description": "Types of membership roles within organizations (tag, bentlakó tag, szimpatizáns, etc.)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "maxLength": 255,
      "required": true,
      "unique": true,
      "metadatas": {
        "label": "Név",
        "description": "A tagság típus neve (pl. tag, bentlakó tag, szimpatizáns)"
      }
    },
    "description": {
      "type": "text",
      "metadatas": {
        "label": "Leírás",
        "description": "A tagság típus részletes leírása"
      }
    },
    "color": {
      "type": "string",
      "maxLength": 7,
      "metadatas": {
        "label": "Szín",
        "description": "A tagság típus színe (hex kód, pl. #FF0000)"
      }
    },
    "memberships": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::membership.membership",
      "mappedBy": "membership_type",
      "metadatas": {
        "label": "Tagságok",
        "description": "Az ehhez a típushoz tartozó tagságok"
      }
    }
  }
}
