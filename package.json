{
  "name": "backend-strapi",
  "version": "0.1.0",
  "private": true,
  "description": "Curr Strapi API",
  "scripts": {
    "console": "strapi console",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "strapi": "strapi develop",
    "local": "strapi develop",
    "typecheck": "tsc --noEmit",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "seed": "node scripts/seed-database.js",
    "seed:help": "node scripts/seed-database.js --help",
    "seed:basic": "node scripts/seed-database.js --name \"Zöld források szövetkezet @Szupatak\" --level 0",
    "seed:full": "node scripts/seed-database.js --name \"Zöld források szövetkezet @Szupatak\" --level 3 --accounts",
    "seed:http:edizone": "httpyac send database/seeders/http/common/0*.http --all --var dataDir=database/seeders/http/edizone/data --env",
    "seed:http:edizone:local": "httpyac send database/seeders/http/common/0*.http --all --var dataDir=database/seeders/http/edizone/data --env local",
    "seed:http:kor": "httpyac send database/seeders/http/common/0*.http --all --var dataDir=database/seeders/http/kor/data --env",
    "seed:http:kor:local": "httpyac send database/seeders/http/common/0*.http --all --var dataDir=database/seeders/http/kor/data --env local",
    "seed:http:reset": "httpyac send database/seeders/http/common/reset.http --all --env",
    "seed:http:reset:all": "httpyac send database/seeders/http/common/reset.http --all --var wipeAll=true --env",
    "####BUILD & DEPLOY####": "echo 'This is a placeholder for a real command.'",
    "build": "strapi build",
    "start": "strapi start",
    "generate:secrets": "node scripts/generate-secrets.js",
    "deploy": "npm run deploy:kor.fejlesztesek.hu",
    "_predeploy:kor.fejlesztesek.hu": "npm run build",
    "deploy:kor.fejlesztesek.hu": "bash scripts/ftp-deploy.sh .env.deploy:kor.fejlesztesek.hu",
    "__deploy:cloud:strapi": "strapi deploy",
    "docker:dev": "docker compose --env-file .env.docker up -d",
    "docker:stop": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f",
    "ci:npm:install:cron": "/bin/bash -lc 'source /home/ysgljxyi/nodevenv/node/kor-szupatak/22/bin/activate && cd /home/ysgljxyi/node/kor-szupatak && NODE_OPTIONS=--max-old-space-size=768 npm install --omit=dev --no-audit --no-fund> /home/ysgljxyi/npm-install.log 2>&1'"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "@strapi/plugin-cloud": "5.58.0",
    "@strapi/plugin-documentation": "5.58.0",
    "@strapi/plugin-graphql": "5.58.0",
    "@strapi/plugin-users-permissions": "5.58.0",
    "@strapi/provider-upload-cloudinary": "5.58.0",
    "@strapi/strapi": "5.58.0",
    "better-sqlite3": "11.3.0",
    "pg": "^8.16.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "strapi-schema-extender": "^1.1.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "httpyac": "^6.16.7",
    "nx": "^23.3.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.15.0 <=22.x.x",
    "npm": ">=10"
  },
  "strapi": {
    "uuid": "db71b102-aec9-4739-b2da-8097e22526c2",
